{
  "info": {
    "name": "lb4 - theatre security",
    "description": "Демонстрация Basic Auth, CSRF, регистрации, ролей и бизнес-операций. Коллекция создаёт уникальные email и собственные представления при каждом запуске, поэтому повторный запуск не требует re-seed. Демо-пароль всех seed-пользователей: Password1!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userEmail", "value": "user@example.com" },
    { "key": "userPassword", "value": "Password1!" },
    { "key": "managerEmail", "value": "manager@example.com" },
    { "key": "managerPassword", "value": "Password1!" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Password1!" },
    { "key": "blockedEmail", "value": "blocked@example.com" },
    { "key": "blockedPassword", "value": "Password1!" },
    { "key": "otherEmail", "value": "other@example.com" },
    { "key": "registrationPassword", "value": "Password1!" },
    { "key": "createdUserPassword", "value": "Password1!" },
    { "key": "runSuffix", "value": "" },
    { "key": "registeredEmail", "value": "" },
    { "key": "roleAttemptEmail", "value": "" },
    { "key": "weakEmail", "value": "" },
    { "key": "createdUserEmail", "value": "" },
    { "key": "runStartTime", "value": "" },
    { "key": "runManagerStartTime", "value": "" },
    { "key": "runManagerRescheduleTime", "value": "" },
    { "key": "runPerformanceId", "value": "" },
    { "key": "xsrfToken", "value": "" },
    { "key": "createdPlayId", "value": "" },
    { "key": "createdPerformanceId", "value": "" },
    { "key": "purchasedTicketId", "value": "" },
    { "key": "createdUserId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const token = pm.cookies.get('XSRF-TOKEN');",
          "if (token) {",
          "  pm.collectionVariables.set('xsrfToken', token);",
          "  pm.request.headers.upsert({ key: 'X-XSRF-TOKEN', value: token });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00. Auth and CSRF",
      "item": [
        {
          "name": "csrf - получить токен и cookie, подготовить уникальные данные запуска",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/csrf" }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);",
                  "pm.collectionVariables.set('runSuffix', suffix);",
                  "pm.collectionVariables.set('registeredEmail', `registered.${suffix}@example.test`);",
                  "pm.collectionVariables.set('roleAttemptEmail', `role.attempt.${suffix}@example.test`);",
                  "pm.collectionVariables.set('weakEmail', `weak.${suffix}@example.test`);",
                  "pm.collectionVariables.set('createdUserEmail', `managed.${suffix}@example.test`);",
                  "const future = (baseYear) => new Date(",
                  "  Date.UTC(baseYear, 0, 1)",
                  "  + Math.floor(Math.random() * 100000) * 86400000",
                  "  + Math.floor(Math.random() * 24 * 60) * 60000",
                  ").toISOString().slice(0, 19);",
                  "pm.collectionVariables.set('runStartTime', future(2100));",
                  "pm.collectionVariables.set('runManagerStartTime', future(2110));",
                  "pm.collectionVariables.set('runManagerRescheduleTime', future(2120));",
                  "pm.collectionVariables.set('runPerformanceId', '');",
                  "pm.collectionVariables.set('createdPlayId', '');",
                  "pm.collectionVariables.set('createdPerformanceId', '');",
                  "pm.collectionVariables.set('purchasedTicketId', '');",
                  "pm.collectionVariables.set('createdUserId', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('xsrfToken', body.token);",
                  "pm.test('token and header returned', () => {",
                  "  pm.expect(body.headerName).to.eql('X-XSRF-TOKEN');",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "register - успешная регистрация (роль USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Registered User\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('self-registration always creates USER', () => pm.expect(pm.response.json().role).to.eql('USER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "register - попытка передать role=ADMIN игнорируется",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Role Attempt\",\n  \"email\": \"{{roleAttemptEmail}}\",\n  \"password\": \"{{registrationPassword}}\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('role is still USER', () => pm.expect(pm.response.json().role).to.eql('USER'));"
                ]
              }
            }
          ]
        },
        {
          "name": "register - слабый пароль (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Weak Password\",\n  \"email\": \"{{weakEmail}}\",\n  \"password\": \"pass123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "register - повторный email (409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Registered User\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"{{registrationPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "setup - MANAGER создаёт представление для повторяемых USER-сценариев",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playId\": 1,\n  \"hallId\": 1,\n  \"startTime\": \"{{runStartTime}}\",\n  \"basePrice\": 1000.00,\n  \"status\": \"SCHEDULED\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/performances" },
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{managerEmail}}" }, { "key": "password", "value": "{{managerPassword}}" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('runPerformanceId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
