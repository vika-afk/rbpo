          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Новая пьеса\",\n  \"durationMinutes\": 90,\n  \"ageLimit\": 12,\n  \"archived\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/plays" },
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{managerEmail}}" }, { "key": "password", "value": "{{managerPassword}}" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('createdPlayId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST plays/{id}/archive - MANAGER может архивировать",
