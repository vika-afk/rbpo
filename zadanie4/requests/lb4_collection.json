            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{managerEmail}}" }, { "key": "password", "value": "{{managerPassword}}" }] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }
          ]
        },
        {
          "name": "POST plays без CSRF (403)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Без CSRF\",\n  \"durationMinutes\": 90,\n  \"ageLimit\": 12,\n  \"archived\": false\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/plays" },
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{managerEmail}}" }, { "key": "password", "value": "{{managerPassword}}" }] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.request.headers.remove('X-XSRF-TOKEN');"]
              }
            },
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }
          ]
        }
      ]
    },
    {
      "name": "04. ADMIN scenarios",
      "item": [
        {
          "name": "GET users - список пользователей",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/users" },
            "auth": { "type": "basic", "basic": [{ "key": "username", "value": "{{adminEmail}}" }, { "key": "password", "value": "{{adminPassword}}" }] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }
          ]
